# Frontend config. Copy to `.env` and fill in.
# The deployed Worker URL, e.g. https://inchat-api.<you>.workers.dev
# Leave empty for local dev (Vite proxies /api to `wrangler dev` on :8787).
VITE_API_URL=

# Turnstile site key for the room-creation human check (dash → Turnstile).
# Leave empty to disable the widget (creation check is skipped unless the
# Worker has TURNSTILE_SECRET_KEY set — keep both in sync).
VITE_TURNSTILE_SITE_KEY=
