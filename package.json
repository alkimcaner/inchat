{
  "name": "inchat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Voice chat desktop app — Tauri + React + Cloudflare RealtimeKit",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "dependencies": {
    "@cloudflare/realtimekit-react": "^2.0.2",
    "@cloudflare/realtimekit-react-ui": "^2.0.2",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.134.0"
  }
}
