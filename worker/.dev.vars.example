# Local secrets for `wrangler dev`. Copy to .dev.vars (git-ignored).
# For production, use: wrangler secret put <NAME>
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_APP_ID=
# Optional: enables the Turnstile human check on room creation.
# Pair with VITE_TURNSTILE_SITE_KEY in the frontend .env.
TURNSTILE_SECRET_KEY=
